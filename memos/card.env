# Settings for the memos card.
# Edit this copy on the machine before you start the containers.
# The admin's password is not here: memos-secrets makes it on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place memos.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Memos. The container port stays 5230.
MEMOS_PORT=5230

# Label used to build the memos hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then its full URL, with https://.
MEMOS_URL=

# The admin made by prepare.sh before Memos is public.
MEMOS_ADMIN_USER=admin

# Leave commented to run the version the card was tested with.
# MEMOS_IMAGE=
