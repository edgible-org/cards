# Settings for the dayglance card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place dayglance.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for dayGLANCE. The container port stays 80.
DAYGLANCE_PORT=6767

# 1 makes the calendar and WebDAV proxy refuse private-network addresses (a server at home).
DAYGLANCE_PROXY_BLOCK_PRIVATE=0
