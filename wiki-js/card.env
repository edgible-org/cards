# Settings for the wiki-js card.
# Edit this copy on the machine before you start the containers.
# The database password is not here: wiki-js-secrets makes it on the machine (card.yml secrets:).
# You choose the admin's email and password, and the wiki's address, in Wiki.js's own setup page.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place wiki-js.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Wiki.js. The container port stays 3000.
WIKI_JS_PORT=3000
