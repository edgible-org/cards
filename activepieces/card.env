# Settings for the activepieces card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: activepieces-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place activepieces. Both apps run on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Label used to build the editor and webhook hostnames.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave these two empty, unless Activepieces uses your own domain. Then the editor's full URL and
# the webhook hostname's full URL, each as the Compose file builds them from ORG_LABEL.
ACTIVEPIECES_URL=
ACTIVEPIECES_WEBHOOK_URL=

# Host port. activepieces and activepieces-hooks are one process. The container port stays 80.
ACTIVEPIECES_PORT=80
