# Settings for the passbolt card.
# Edit this copy on the machine before you start the containers.
# The database password is not here: passbolt-secrets makes it on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place passbolt.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Passbolt. The container port stays 8080.
PASSBOLT_PORT=8086

# Label used to build the passbolt hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then its full URL, with https://.
PASSBOLT_URL=

# The email address of the first admin, made by prepare.sh. Use one you can read.
PASSBOLT_ADMIN_EMAIL=

# Mail, so Passbolt can invite people and send recovery links. Leave the host as it is to send
# none: the admin's first sign-in link is printed by prepare.sh and needs no mail.
PASSBOLT_EMAIL_FROM=passbolt@localhost
PASSBOLT_SMTP_HOST=localhost
PASSBOLT_SMTP_PORT=25
PASSBOLT_SMTP_TLS=false
PASSBOLT_SMTP_USERNAME=
# The SMTP password is a key you bring, from your mail provider. Empty sends no mail.
PASSBOLT_SMTP_PASSWORD=
