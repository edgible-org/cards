# Settings for the seatsurfing card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: seatsurfing-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place seatsurfing.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Label used to build the seatsurfing hostname.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
# It is the part after the app name in a hostname that `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Host port for Seatsurfing. The container port stays 8080.
SEATSURFING_PORT=8080

# The name of your club or business, shown in the app. Used once, when the first start makes the organization.
SEATSURFING_ORG_NAME="My Club"

# Mail server for invitations and password resets. Optional, but members cannot reset a password without one.
SEATSURFING_SMTP_HOST=
SEATSURFING_SMTP_PORT=587
SEATSURFING_SMTP_START_TLS=1
# Set to 1 when the mail server needs SEATSURFING_SMTP_USER and SEATSURFING_SMTP_PASSWORD.
SEATSURFING_SMTP_AUTH=0
SEATSURFING_SMTP_USER=
# The mail server's password, for SEATSURFING_SMTP_USER.
SEATSURFING_SMTP_PASSWORD=
# The address the mail comes from.
SEATSURFING_SMTP_FROM=no-reply@example.com

