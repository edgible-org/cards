# Settings for the paperless-ngx card.
# Edit this copy on the machine before you start the containers.
# The passwords and keys are not here: paperless-ngx-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place paperless-ngx.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Paperless-ngx. The container port stays 8000.
PAPERLESS_NGX_PORT=8000

# Label used to build the paperless-ngx hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then its full URL, with https://.
PAPERLESS_NGX_URL=

# The admin Paperless makes at its first start (its password is made on the machine).
PAPERLESS_NGX_ADMIN_USER=admin

# The language of your documents, for reading their text: Tesseract codes such as eng or deu+eng.
PAPERLESS_NGX_OCR_LANGUAGE=eng

# Your time zone, such as Europe/Berlin, for dates on documents.
PAPERLESS_NGX_TIME_ZONE=UTC
