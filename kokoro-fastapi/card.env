# Settings for the kokoro-fastapi card.
# Edit this copy on the machine before you start the containers.
# The card has no passwords or keys of its own: callers use an Edgible API key, made with
# `edgible app api-keys create` after Publish.

# Serving device for place kokoro-fastapi.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Kokoro. kokoro-fastapi and kokoro-fastapi-ui are one process. The container port stays 8880.
KOKORO_FASTAPI_PORT=8880

# Uncomment to run an image you built instead of the pinned one.
# KOKORO_FASTAPI_IMAGE=
