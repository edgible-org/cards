# Settings for the static-site card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place static-site.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the site. The container port stays 8080.
STATIC_SITE_PORT=8080

# Where the site comes from: a .tar.gz of the built site.
# A branch of a Git repo works, such as a GitHub branch archive:
#   https://github.com/<owner>/<repo>/archive/refs/heads/<branch>.tar.gz
# For a private GitHub repo, use the API's address for it instead, with a token below:
#   https://api.github.com/repos/<owner>/<repo>/tarball/<branch>
STATIC_SITE_SOURCE=

# Empty for a source anyone can download. For a private one, a token that can read it, sent
# as a Bearer token. On GitHub: a fine-grained token for that one repo, with read-only
# Contents. GitLab and Gitea accept their read-only access tokens the same way.
STATIC_SITE_TOKEN=

# How many leading folders to drop from the archive's paths. A Git host's archive puts
# everything in one top folder, such as repo-branch/, so 1. A tarball made with
# tar -C site -czf site.tgz . has none, so 0.
STATIC_SITE_STRIP=1

# How often to check the source for a new version, in seconds.
STATIC_SITE_EVERY=300

# The page that answers a path the site has no file for. Empty: the site's 404.html, with
# status 404. A single-page app with its own routes, such as a React, Vue, or Svelte app
# with a router, needs /index.html here, or opening one of its pages directly gives 404.
STATIC_SITE_FALLBACK=
