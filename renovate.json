{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "docker-compose"
  ],
  "labels": [
    "image-bump"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": [
    "before 6am"
  ],
  "packageRules": [
    {
      "description": "Minor, patch and digest bumps merge themselves once the bump-test and cards checks pass; a major waits for a yes below",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true
    },
    {
      "description": "A major version can need a data migration, so it waits for a yes on the dependency dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "ignoreDeps": [
    "website-site",
    "website-strapi"
  ],
  "platformAutomerge": true,
  "gitIgnoredAuthors": [
    "actions@github.com"
  ]
}
