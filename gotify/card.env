# Settings for the gotify card.
# Edit this copy on the machine before you start the containers.
# The admin's password is not here: gotify-secrets makes it on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place gotify.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Gotify. The container port stays 80.
GOTIFY_PORT=8080

# The admin's name. Its password is made on this machine at first start.
GOTIFY_DEFAULTUSER_NAME=admin
