# Settings for the qdrant card.
# Edit this copy on the machine before you start the containers.
# The card has no passwords or keys of its own: callers use an Edgible API key, made with
# `edgible app api-keys create` after Publish.

# Serving device for place qdrant.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Qdrant. qdrant and qdrant-dashboard are one process. The container port stays 6333.
QDRANT_PORT=6333

# Uncomment to run an image you built from Qdrant's source instead of the pinned one.
# QDRANT_IMAGE=
