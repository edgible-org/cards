# Settings for the mediamtx card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place mediamtx.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the HLS player, published through Edgible. The container port stays 8888.
MEDIAMTX_PORT=8888

# Host ports on the home network for cameras and players. The container ports stay 8554, 1935 and 8890.
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_SRT_PORT=8890

# The password your cameras and encoders use, with the user name publisher, to send a stream.
# You choose it: a long one, since anyone on the home network can try it.
MEDIAMTX_PUBLISH_PASSWORD=
