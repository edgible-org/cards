# Settings for the rybbit card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: rybbit-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place rybbit.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the Rybbit dashboard. The container port stays 8080.
RYBBIT_PORT=8080

# Host port for the tracking script and page-view endpoint (rybbit-analytics). The container port stays 8081.
RYBBIT_ANALYTICS_PORT=8081

# Label used to build the rybbit and rybbit-analytics hostnames.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the dashboard uses your own domain. Then its full URL, with https://.
RYBBIT_URL=

# Set to true once your own account exists, to stop anyone else signing up.
RYBBIT_DISABLE_SIGNUP=false

# Leave commented, unless you build Rybbit from source. Then the images you built.
# RYBBIT_BACKEND_IMAGE=
# RYBBIT_CLIENT_IMAGE=
