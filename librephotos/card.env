# Settings for the librephotos card.
# Edit this copy on the machine before you start the containers.
# The card's passwords are not here: librephotos-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place librephotos.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for LibrePhotos. The container port stays 8001.
LIBREPHOTOS_PORT=8001

# The admin's email, for password-reset mail. It may stay empty. The admin's user name is admin.
LIBREPHOTOS_ADMIN_EMAIL=
