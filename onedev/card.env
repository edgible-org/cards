# Settings for the onedev card.
# Edit this copy on the machine before you start the containers.
# The card's passwords are not here: onedev-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place onedev.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for OneDev's web. The container port stays 6610.
ONEDEV_PORT=6610

# Host port for Git over SSH. A TCP app's port is from 20000 to 29999. The container port stays 6611.
ONEDEV_SSH_PORT=22611

# Label used to build the onedev and onedev-ssh hostnames.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the web uses your own domain. Then its full URL, with https://.
ONEDEV_URL=

# Leave empty, unless Git over SSH uses your own domain. Then its hostname, without https://.
ONEDEV_SSH_DOMAIN=

# The administrator's email address (user "admin"). Used only at the first start. Change it to yours.
ONEDEV_ADMIN_EMAIL=admin@example.com

# To run a version you built from source, set the image here. Remove the line to go back.
# ONEDEV_IMAGE=
