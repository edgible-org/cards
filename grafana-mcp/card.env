# Settings for the grafana-mcp card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place grafana-mcp.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for grafana-mcp. The container port stays 8000.
GRAFANA_MCP_PORT=8000

# The Grafana to reach, as this machine's Docker sees it. A Grafana on this machine is
# http://host.docker.internal:3000 (its port); another is its own address.
GRAFANA_MCP_URL=

# A service account token from that Grafana: Administration, Users and access, Service accounts.
# A Viewer account is enough to read. The assistant can do what the account can.
GRAFANA_MCP_SERVICE_ACCOUNT_TOKEN=

# Flags for the MCP server. --disable-write keeps it read-only: remove it only when the
# assistant should change dashboards, alerts and the like. Other flags:
# https://github.com/grafana/mcp-grafana#usage
GRAFANA_MCP_ARGS="--disable-write"
