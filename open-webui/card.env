# Settings for the open-webui card.
# Edit this copy on the machine before you start the containers.
# The admin's password and the signing key are not here: open-webui-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place open-webui.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Open WebUI. The container port stays 8080.
OPEN_WEBUI_PORT=8080

# Label used to build the open-webui hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then its full URL, with https://.
OPEN_WEBUI_URL=

# The admin made at first start. Its password is the human secret OPEN_WEBUI_ADMIN_PASSWORD.
OPEN_WEBUI_ADMIN_EMAIL=admin@example.com

# Where the models are. These are read at the first start only; after that, change them in the
# app, under Admin Settings, Connections.
# Ollama, such as the ollama-osx card on this Mac or Ollama on this machine's GPU.
OPEN_WEBUI_OLLAMA_URL=http://host.docker.internal:11434
# An OpenAI-compatible service (a provider, or the litellm card's gateway): set true, the
# address, and OPENAI_API_KEY below.
OPEN_WEBUI_ENABLE_OPENAI_API=false
OPEN_WEBUI_OPENAI_API_BASE_URL=https://api.openai.com/v1
# The key for that service, if you use one.
OPENAI_API_KEY=

# Leave commented to run the version the card was tested with.
# OPEN_WEBUI_IMAGE=
