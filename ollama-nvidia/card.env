# Settings for the ollama-nvidia card. See README.md.
# Edit this copy on the machine before you start the containers.

# Serving device for place ollama, as `edgible device list` names it. The Compose file does not read this.
DEVICE=
# The part after the app name in your Edgible hostnames, such as example in ollama.example.edgible.app.
ORG_LABEL=
# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
EDGIBLE_DOMAIN=edgible.app

# Ollama's own port, on this machine only (127.0.0.1): manage models here (pull, delete).
OLLAMA_LOCAL_PORT=11434

# The proxy in front of Ollama, also on 127.0.0.1. Edgible publishes this one, so a key can use
# a model but not pull or delete one.
OLLAMA_PORT=21434

# How long a model stays loaded in GPU memory after its last request.
OLLAMA_KEEP_ALIVE=10m

# To run your own build of Ollama, set its image here.
# OLLAMA_IMAGE=
