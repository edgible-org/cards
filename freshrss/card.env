# Settings for the freshrss card.
# Edit this copy on the machine before you start the containers.
# The admin's passwords are not here: freshrss-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place freshrss.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for FreshRSS. The container port stays 80.
FRESHRSS_PORT=8080

# Label used to build the freshrss hostnames.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then its full URL, with https://.
FRESHRSS_URL=

# The admin made on first start.
FRESHRSS_ADMIN_USER=admin

# The server's time zone, from https://www.php.net/manual/en/timezones.php
FRESHRSS_TZ=UTC

# The minutes of each hour at which FreshRSS refreshes every feed.
FRESHRSS_CRON_MIN=7,37

# To run an image you built from the source, uncomment this and set its name.
# FRESHRSS_IMAGE=
