# Settings for the chatwoot card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: chatwoot-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place chatwoot.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Chatwoot. The container port stays 3000.
CHATWOOT_PORT=3000

# Label used to build the chatwoot hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then its full URL, with https://.
CHATWOOT_URL=

# The email of the admin prepare.sh makes. Use your own, so you can sign in and add agents.
CHATWOOT_ADMIN_EMAIL=admin@example.org

# The name of the first account, shown to agents.
CHATWOOT_ACCOUNT_NAME="Support"

# Mail server, so Chatwoot can email agents and customers. Optional: without it, nothing is sent.
CHATWOOT_SMTP_ADDRESS=
CHATWOOT_SMTP_PORT=587
CHATWOOT_SMTP_USERNAME=
# The mail server's password, for CHATWOOT_SMTP_USERNAME.
CHATWOOT_SMTP_PASSWORD=
# The address the mail comes from.
CHATWOOT_MAILER_SENDER_EMAIL="Support <noreply@example.com>"
