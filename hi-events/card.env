# Settings for the hi-events card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: hi-events-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place hi-events.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Label used to build the hi-events hostname.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
# It is the part after the app name in a hostname that `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Host port for Hi.Events. The container port stays 80.
HI_EVENTS_PORT=8123

# Email of the organizer account that prepare.sh makes. Sign-up is closed after that.
HI_EVENTS_ADMIN_EMAIL=

# The name shown on pages and in emails.
HI_EVENTS_APP_NAME=Hi.Events

# Mail for ticket confirmations and password resets. With `log` nothing is sent: emails are
# written to the app's log. Set it to `smtp` and fill the lines below to send them.
HI_EVENTS_MAIL_MAILER=log
HI_EVENTS_SMTP_HOST=
HI_EVENTS_SMTP_PORT=587
HI_EVENTS_SMTP_ENCRYPTION=tls
HI_EVENTS_SMTP_USER=
# The mail server's password, for HI_EVENTS_SMTP_USER.
HI_EVENTS_SMTP_PASSWORD=
# The address the mail comes from.
HI_EVENTS_SMTP_FROM=noreply@example.com
