# Settings for the notediscovery card.
# Edit this copy on the machine before you start the containers.
# The card has no passwords or keys of its own: people sign in to Edgible, and AI assistants
# send an Edgible API key, made with `edgible app api-keys create` after Publish.

# Serving device for place notediscovery.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for NoteDiscovery. notediscovery and notediscovery-mcp are one process. The container port stays 8000.
NOTEDISCOVERY_PORT=8000

# Label used to build the hostnames.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# Time zone for the notes' dates.
NOTEDISCOVERY_TZ=UTC

# Uncomment to run an image you built from NoteDiscovery's source instead of the pinned one.
# NOTEDISCOVERY_IMAGE=
