# Settings for the hedgedoc card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: hedgedoc-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place hedgedoc.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for HedgeDoc. The container port stays 3000.
HEDGEDOC_PORT=3000

# Label used to build the hedgedoc hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then its host name only, without https://.
HEDGEDOC_DOMAIN=

# The first account, made by prepare.sh before HedgeDoc is published. HedgeDoc signs in by email.
HEDGEDOC_ADMIN_EMAIL=admin@example.com

# Whether anyone who reaches HedgeDoc may make an account. The org login in front lets only your
# organisation's members reach it, so true lets them sign themselves up. Set false to add each
# account yourself with bin/manage_users (see the README).
HEDGEDOC_ALLOW_REGISTER=true

# Leave commented to run the version the card was tested with.
# HEDGEDOC_IMAGE=
