# Settings for the redaxo card.
# Edit this copy on the machine before you start the containers.
# The passwords are not here: redaxo-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place redaxo.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for REDAXO. The container port stays 80.
REDAXO_PORT=8087

# Label used to build the redaxo hostnames.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the site uses your own domain. Then its full URL, with https://.
REDAXO_URL=

# The admin made on first start, and the address REDAXO sends its error mails to.
# Change the address to yours.
REDAXO_ADMIN_USER=admin
REDAXO_ADMIN_EMAIL=admin@example.com

# The site's name, the back end's language (en_gb, de_de, ...) and the server's time zone.
REDAXO_SITE_NAME="My site"
REDAXO_LANG=en_gb
REDAXO_TIMEZONE=UTC
