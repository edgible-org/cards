# Settings for the arize-phoenix card.
# Edit this copy on the machine before you start the containers.
# The card has no passwords or keys: Edgible signs people in and checks the ingestion key.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place arize-phoenix.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Phoenix. arize-phoenix and arize-phoenix-ingest are one process. The container port stays 6006.
ARIZE_PHOENIX_PORT=6006

# Days to keep stored traces and prompts. 0 keeps them forever; set a number when prompts hold personal data.
ARIZE_PHOENIX_RETENTION_DAYS=0
