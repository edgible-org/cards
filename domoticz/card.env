# Settings for the domoticz card.
# Edit this copy on the machine before you start the containers.
# The admin's password is not here: domoticz-secrets makes it on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place domoticz.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the web interface, published on org. The container port stays 8080.
DOMOTICZ_PORT=8080

# Host port for the phone apps, published on none. It reaches the same Domoticz.
DOMOTICZ_APP_PORT=8083

# Label used to build the hostnames.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# The admin made by prepare.sh before Domoticz is public.
DOMOTICZ_ADMIN_USER=admin

# Your time zone, as a name from the tz database, such as Europe/Amsterdam.
# Timers and sunrise rules use it.
DOMOTICZ_TZ=UTC

# Leave commented to run the version the card was tested with.
# DOMOTICZ_IMAGE=
